{
  "manifest_version": 3,
  "name": "summit: one step at a time",
  "version": "1.0.0",
  "description": "your to-do list with a clock and scenic backgrounds on every new tab.",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "open summit" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
